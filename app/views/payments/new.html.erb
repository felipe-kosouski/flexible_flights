<% content_for :title, "Get Search Credits — Flexible Flights" %>

<div class="w-full max-w-3xl mx-auto">
  <div class="mb-8 text-center">
    <h1 class="text-2xl font-heading font-semibold text-warm-900 tracking-tight"><%= t("pages.home.pricing.title") %></h1>
    <p class="mt-1.5 text-sm text-warm-500">
      You have
      <span class="font-semibold text-warm-700">
        <%= current_user.search_credits %> <%= current_user.search_credits == 1 ? "credit" : "credits" %>
      </span>
      remaining
    </p>
  </div>

  <% brl = I18n.locale.to_s == "pt-BR" %>
  <% pack_meta = credit_pack_meta %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <% CREDIT_PACKS.each do |key, pack| %>
      <% meta = pack_meta[key] %>
      <% cta = capture do %>
        <%= button_to payments_path(pack_key: key), method: :post, data: { turbo: false },
              class: "w-full text-center font-semibold text-sm rounded-lg px-4 py-2.5 transition-colors cursor-pointer #{meta[:highlight] ? "bg-brand-700 hover:bg-brand-800 active:bg-brand-900 text-white" : "bg-warm-100 hover:bg-warm-200 active:bg-warm-300 text-warm-900"}" do %>
          <%= t("pages.home.pricing.buy_now") %>
        <% end %>
      <% end %>
      <%= render "shared/pricing_card", pack: pack, meta: meta, brl: brl, cta: cta %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-xs text-warm-400"><%= t("pages.home.pricing.footer_note") %></p>
</div>
