<% content_for :title, "Flexible Flights — Fly when the moment is right" %>
<% content_for :main_class, "w-full" %>

<%# ─────────────────────────────────────────────────────────────────
    HERO
    ───────────────────────────────────────────────────────────────── %>
<section class="bg-warm-50 px-5 pt-20 pb-16 sm:pt-28 sm:pb-24">
  <div class="max-w-2xl mx-auto text-center">

    <span class="inline-block text-xs font-semibold uppercase tracking-widest text-brand-600 bg-brand-50 px-3 py-1.5 rounded-full border border-brand-100">
      <%= t("pages.home.hero.tag") %>
    </span>

    <h1 class="mt-6 font-heading font-bold text-warm-900 text-4xl sm:text-5xl leading-tight tracking-tight">
      <%= t("pages.home.hero.title") %>
    </h1>

    <p class="mt-5 text-lg text-warm-500 leading-relaxed max-w-xl mx-auto">
      <%= t("pages.home.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= link_to t("pages.home.hero.cta_primary"), new_user_registration_path,
            class: "w-full sm:w-auto inline-flex items-center justify-center h-11 px-6 rounded-lg bg-accent-500 hover:bg-accent-600 text-white font-semibold text-sm transition-colors cursor-pointer" %>
      <a href="#how-it-works"
         class="w-full sm:w-auto inline-flex items-center justify-center h-11 px-5 rounded-lg text-brand-600 font-medium text-sm hover:bg-brand-50 transition-colors">
        <%= t("pages.home.hero.cta_secondary") %>
        <svg class="ml-1.5 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
      </a>
    </div>

    <p class="mt-4 text-xs text-warm-400"><%= t("pages.home.hero.free_note") %></p>

  </div>

  <%# Mock recommendation card — shows what a result looks like %>
  <div class="max-w-sm mx-auto mt-14">
    <div class="rounded-2xl border border-warm-200 bg-white shadow-sm overflow-hidden">
      <div class="bg-emerald-50 border-b border-emerald-100 px-5 py-4">
        <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-1">
          <%= t("insights.recommendation_label") %>
        </p>
        <p class="font-heading font-bold text-2xl text-emerald-700 leading-none">
          <%= t("insights.wait_or_book.book_now") %>
        </p>
        <p class="mt-2 text-sm text-emerald-800/75 leading-snug">
          <%= t("insights.subtext.high_book_now") %>
        </p>
      </div>
      <div class="px-5 py-3 flex flex-wrap gap-2">
        <span class="inline-flex items-center text-xs font-semibold bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-full">
          <%= t("insights.price_rarity.rare_cheap") %>
        </span>
        <span class="inline-flex items-center text-xs font-semibold bg-brand-50 text-brand-700 px-2.5 py-1 rounded-full">
          <%= t("insights.confidence.high") %>
        </span>
      </div>
      <div class="px-5 pb-4">
        <div class="rounded-xl border border-warm-200 bg-warm-50 px-4 py-3">
          <p class="text-xs font-semibold text-warm-400 uppercase tracking-wider mb-1">
            <%= t("insights.best_time_label") %>
          </p>
          <p class="font-heading font-semibold text-warm-900">Mar 12 — Mar 19</p>
          <p class="text-xs text-warm-400 mt-0.5">7 nights · Score 84/100</p>
        </div>
      </div>
    </div>
    <p class="text-center text-xs text-warm-400 mt-3">← <%= t("pages.home.hero.free_note").split("·").first.strip %></p>
  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    TRUST BAR
    ───────────────────────────────────────────────────────────────── %>
<section class="bg-white border-y border-warm-200 py-5 px-5">
  <div class="max-w-3xl mx-auto">
    <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 list-none m-0 p-0">
      <li class="flex items-center gap-2 text-sm text-warm-600">
        <svg class="w-4 h-4 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
        </svg>
        <%= t("pages.home.trust.airports") %>
      </li>
      <li class="flex items-center gap-2 text-sm text-warm-600">
        <svg class="w-4 h-4 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <%= t("pages.home.trust.free_search") %>
      </li>
      <li class="flex items-center gap-2 text-sm text-warm-600">
        <svg class="w-4 h-4 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
        </svg>
        <%= t("pages.home.trust.languages") %>
      </li>
      <li class="flex items-center gap-2 text-sm text-warm-600">
        <svg class="w-4 h-4 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
        </svg>
        <%= t("pages.home.trust.no_subscription") %>
      </li>
    </ul>
  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    HOW IT WORKS
    ───────────────────────────────────────────────────────────────── %>
<section id="how-it-works" class="bg-white px-5 py-20 sm:py-24">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-14">
      <h2 class="font-heading font-bold text-3xl text-warm-900 tracking-tight">
        <%= t("pages.home.how_it_works.title") %>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <% [
        {
          number: t("pages.home.how_it_works.step_1_number"),
          title:  t("pages.home.how_it_works.step_1_title"),
          body:   t("pages.home.how_it_works.step_1_body"),
          icon:   '<path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5V3.75m0 9.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m12-3V3.75m0 9.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m-6-9V3.75m0 3.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 9.75V10.5" />'
        },
        {
          number: t("pages.home.how_it_works.step_2_number"),
          title:  t("pages.home.how_it_works.step_2_title"),
          body:   t("pages.home.how_it_works.step_2_body"),
          icon:   '<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />'
        },
        {
          number: t("pages.home.how_it_works.step_3_number"),
          title:  t("pages.home.how_it_works.step_3_title"),
          body:   t("pages.home.how_it_works.step_3_body"),
          icon:   '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />'
        }
      ].each_with_index do |step, i| %>
        <div class="relative bg-warm-50 rounded-2xl border border-warm-200 p-6">
          <div class="flex items-start gap-4 mb-4">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                <%= step[:icon].html_safe %>
              </svg>
            </div>
            <span class="font-heading font-bold text-4xl text-warm-200 leading-none mt-0.5 tabular-nums">
              <%= step[:number] %>
            </span>
          </div>
          <h3 class="font-heading font-semibold text-lg text-warm-900 mb-2"><%= step[:title] %></h3>
          <p class="text-sm text-warm-500 leading-relaxed"><%= step[:body] %></p>
        </div>
      <% end %>

    </div>
  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    WHAT YOU GET (4 insight cards)
    ───────────────────────────────────────────────────────────────── %>
<section class="bg-warm-100 px-5 py-20 sm:py-24">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-14">
      <h2 class="font-heading font-bold text-3xl text-warm-900 tracking-tight">
        <%= t("pages.home.insights.title") %>
      </h2>
      <p class="mt-3 text-warm-500 text-base max-w-lg mx-auto">
        <%= t("pages.home.insights.subtitle") %>
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

      <% [
        {
          title: t("pages.home.insights.wait_or_book_title"),
          body:  t("pages.home.insights.wait_or_book_body"),
          color: "emerald",
          icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />'
        },
        {
          title: t("pages.home.insights.price_rarity_title"),
          body:  t("pages.home.insights.price_rarity_body"),
          color: "blue",
          icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />'
        },
        {
          title: t("pages.home.insights.best_time_title"),
          body:  t("pages.home.insights.best_time_body"),
          color: "brand",
          icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />'
        },
        {
          title: t("pages.home.insights.comfort_window_title"),
          body:  t("pages.home.insights.comfort_window_body"),
          color: "amber",
          icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />'
        }
      ].each do |card| %>
        <div class="bg-white rounded-2xl border border-warm-200 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-xl mb-4 flex items-center justify-center
            <%= case card[:color]
                when "emerald" then "bg-emerald-100"
                when "blue"    then "bg-blue-100"
                when "brand"   then "bg-brand-50"
                when "amber"   then "bg-amber-100"
                end %>">
            <svg class="w-5 h-5
              <%= case card[:color]
                  when "emerald" then "text-emerald-600"
                  when "blue"    then "text-blue-600"
                  when "brand"   then "text-brand-600"
                  when "amber"   then "text-amber-600"
                  end %>"
                 fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <%= card[:icon].html_safe %>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-warm-900 mb-2"><%= card[:title] %></h3>
          <p class="text-sm text-warm-500 leading-relaxed"><%= card[:body] %></p>
        </div>
      <% end %>

    </div>
  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    PRICING
    ───────────────────────────────────────────────────────────────── %>
<section id="pricing" class="bg-white px-5 py-20 sm:py-24">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-14">
      <h2 class="font-heading font-bold text-3xl text-warm-900 tracking-tight">
        <%= t("pages.home.pricing.title") %>
      </h2>
      <p class="mt-3 text-warm-500 text-base"><%= t("pages.home.pricing.subtitle") %></p>
    </div>

    <% brl = I18n.locale.to_s == "pt-BR" %>
    <% pack_meta = credit_pack_meta %>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <% CREDIT_PACKS.each do |key, pack| %>
        <% meta = pack_meta[key] %>
        <% cta = capture do %>
          <%= link_to t("pages.home.nav.sign_up"), new_user_registration_path,
                class: "block w-full text-center font-semibold text-sm rounded-lg px-4 py-2.5 transition-colors cursor-pointer #{meta[:highlight] ? "bg-brand-700 hover:bg-brand-800 text-white" : "bg-warm-100 hover:bg-warm-200 text-warm-900"}" %>
        <% end %>
        <%= render "shared/pricing_card", pack: pack, meta: meta, brl: brl, cta: cta %>
      <% end %>
    </div>

    <p class="mt-8 text-center text-xs text-warm-400"><%= t("pages.home.pricing.footer_note") %></p>

  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    FAQ
    ───────────────────────────────────────────────────────────────── %>
<section class="bg-warm-50 px-5 py-20 sm:py-24">
  <div class="max-w-2xl mx-auto">

    <h2 class="font-heading font-bold text-3xl text-warm-900 tracking-tight text-center mb-12">
      <%= t("pages.home.faq.title") %>
    </h2>

    <dl class="space-y-8">
      <% [
        [ t("pages.home.faq.q1"), t("pages.home.faq.a1") ],
        [ t("pages.home.faq.q2"), t("pages.home.faq.a2") ],
        [ t("pages.home.faq.q3"), t("pages.home.faq.a3") ],
        [ t("pages.home.faq.q4"), t("pages.home.faq.a4") ]
      ].each do |q, a| %>
        <div class="border-b border-warm-200 pb-8 last:border-0 last:pb-0">
          <dt class="font-heading font-semibold text-warm-900 mb-2"><%= q %></dt>
          <dd class="text-sm text-warm-500 leading-relaxed"><%= a %></dd>
        </div>
      <% end %>
    </dl>

  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    FINAL CTA STRIP
    ───────────────────────────────────────────────────────────────── %>
<section class="bg-brand-700 px-5 py-16 text-center">
  <div class="max-w-xl mx-auto">
    <h2 class="font-heading font-bold text-3xl text-white tracking-tight">
      <%= t("pages.home.footer.tagline") %>
    </h2>
    <p class="mt-3 text-brand-200 text-base"><%= t("pages.home.hero.free_note") %></p>
    <div class="mt-8">
      <%= link_to t("pages.home.hero.cta_primary"), new_user_registration_path,
            class: "inline-flex items-center h-11 px-8 rounded-lg bg-accent-500 hover:bg-accent-600 text-white font-semibold text-sm transition-colors cursor-pointer" %>
    </div>
  </div>
</section>

<%# ─────────────────────────────────────────────────────────────────
    FOOTER
    ───────────────────────────────────────────────────────────────── %>
<footer class="bg-white border-t border-warm-200 px-5 py-8">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <%= link_to root_path, class: "flex items-center" do %>
      <%= render "shared/logo" %>
    <% end %>
    <p class="text-xs text-warm-400">
      <%= t("pages.home.footer.copyright", year: Date.current.year) %>
    </p>
  </div>
</footer>
