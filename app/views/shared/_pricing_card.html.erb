<%#
  Shared pricing card component.

  Locals:
    pack        — Hash from CREDIT_PACKS (requires :credits key)
    meta        — Hash from credit_pack_meta (label, description, badge, highlight, usd, brl, per_usd, per_brl)
    brl         — Boolean: true when I18n.locale is pt-BR
    cta         — HTML-safe string for the CTA button area (use capture {} in caller)
%>
<div class="relative flex flex-col rounded-2xl border p-6 <%= meta[:highlight] ? "border-brand-600 shadow-md ring-1 ring-brand-600 bg-white" : "border-warm-200 shadow-sm bg-white" %>">

  <% if meta[:badge] %>
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
      <span class="text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap <%= meta[:highlight] ? "bg-brand-700 text-white" : "bg-warm-800 text-white" %>">
        <%= meta[:badge] %>
      </span>
    </div>
  <% end %>

  <div class="mb-5">
    <p class="text-xs font-semibold text-warm-400 uppercase tracking-wider mb-2"><%= meta[:label] %></p>
    <div class="flex items-baseline gap-1.5">
      <span class="text-5xl font-heading font-bold tracking-tight text-warm-900 tabular-nums"><%= pack[:credits] %></span>
      <span class="text-sm font-medium text-warm-400"><%= t("pages.home.pricing.searches") %></span>
    </div>
    <p class="mt-1.5 text-xs text-warm-400 tabular-nums">
      <%= brl ? meta[:per_brl] : meta[:per_usd] %> / <%= t("pages.home.pricing.searches").singularize %>
    </p>
  </div>

  <p class="text-sm text-warm-500 leading-relaxed flex-1 mb-6"><%= meta[:description] %></p>

  <div>
    <p class="text-2xl font-heading font-bold text-warm-900 mb-3 tabular-nums">
      <%= brl ? meta[:brl] : meta[:usd] %>
    </p>
    <%= cta %>
  </div>

</div>
