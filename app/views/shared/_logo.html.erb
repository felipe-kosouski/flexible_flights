<%# Logo mark + wordmark.
    Pass `dark: true` to force the light-on-dark variant (e.g. on explicit dark section backgrounds).
    By default, colors adapt automatically via dark: Tailwind classes and the CSS theme toggle. %>
<% explicit_dark = local_assigns.fetch(:dark, false) %>

<span class="inline-flex items-center gap-2 select-none <%= explicit_dark ? "text-brand-400" : "text-brand-700 dark:text-brand-400" %>">
  <%# Mark: horizon baseline + ascending flight path + signal dot. Uses currentColor. %>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    <line x1="4" y1="17.5" x2="17" y2="6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    <circle cx="17" cy="6" r="2.5" fill="currentColor"/>
  </svg>

  <%# Wordmark %>
  <span class="font-heading font-semibold text-base tracking-tight leading-none <%= explicit_dark ? "text-warm-100" : "text-warm-900 dark:text-warm-100" %>">
    Flexible Flights
  </span>
</span>
