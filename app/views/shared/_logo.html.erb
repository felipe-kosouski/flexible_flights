<%# Logo mark + wordmark. Pass `dark: true` for white variant (e.g. on dark backgrounds). %>
<% dark_mode = local_assigns.fetch(:dark, false) %>
<% mark_color = dark_mode ? "#4B9AB8" : "#0D4A62" %>
<% text_color = dark_mode ? "#EDE9E4" : "#1C1814" %>

<span class="inline-flex items-center gap-2 select-none">
  <%# Minimal mark: horizon baseline + ascending flight path + signal dot %>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <%# Horizon baseline %>
    <line x1="3" y1="18" x2="21" y2="18" stroke="<%= mark_color %>" stroke-width="1.75" stroke-linecap="round"/>
    <%# Ascending path from baseline to upper right %>
    <line x1="4" y1="17.5" x2="17" y2="6" stroke="<%= mark_color %>" stroke-width="1.75" stroke-linecap="round"/>
    <%# Signal dot at peak — the optimal point %>
    <circle cx="17" cy="6" r="2.5" fill="<%= mark_color %>"/>
  </svg>

  <%# Wordmark %>
  <span style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 1rem; letter-spacing: -0.025em; color: <%= text_color %>; line-height: 1;">
    Flexible Flights
  </span>
</span>
