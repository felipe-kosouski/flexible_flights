<div id="search_results" class="w-full">
  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 tracking-tight">
        <%= presenter.origin %> &rarr; <%= presenter.destination %>
      </h1>
      <p class="mt-1 text-sm text-gray-500">
        <%= presenter.sample_count %> <%= t("searches.show.options_analysed") %> &middot;
        <span class="text-red-500"><%= t("insights.confidence.low") %></span>
      </p>
      <p class="mt-1 text-xs text-gray-400">
        <%= presenter.freshness_label %>
        <% if presenter.stale? %>
          &middot;
          <%= link_to "Run again →",
                new_search_path(from_intent: presenter.search_intent_id),
                class: "text-indigo-500 hover:text-indigo-600" %>
        <% end %>
      </p>
    </div>
    <%= link_to new_search_path, class: "text-sm text-indigo-600 hover:text-indigo-700 font-medium" do %>
      <%= t("searches.show.search_again") %> &rarr;
    <% end %>
  </div>

  <%# Low confidence callout %>
  <div class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 mb-8">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
      </svg>
      <div>
        <p class="text-sm font-semibold text-amber-900"><%= t("insights.low_confidence_title") %></p>
        <p class="mt-1 text-sm text-amber-700">
          We found flights but couldn&rsquo;t build a confident market picture for this route and window.
          Recommendations have been withheld. Try a wider date range or more flexible travel window to improve results.
        </p>
      </div>
    </div>
  </div>

  <%# Ranked flights %>
  <div>
    <h2 class="text-base font-semibold text-gray-700 mb-4"><%= t("insights.flights_found") %></h2>
    <div class="space-y-3">
      <% presenter.ranked_flights.each do |flight| %>
        <%= render "searches/flight_card", flight: flight %>
      <% end %>
    </div>
  </div>
</div>
