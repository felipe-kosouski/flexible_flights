<% content_for :title, "Search Flights — Flexible Flights" %>

<div class="w-full max-w-xl mx-auto">
  <div class="mb-8 text-center">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight"><%= t("searches.new.title") %></h1>
    <p class="mt-1.5 text-sm text-gray-500"><%= t("searches.new.subtitle") %></p>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8">
    <%= form_with model: @search_intent, url: searches_path, class: "space-y-5" do |f| %>

      <%# Route %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :origin_airport, t("searches.new.from_label"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <div data-controller="airport-autocomplete" class="relative">
            <input
              type="text"
              data-airport-autocomplete-target="display"
              data-action="input->airport-autocomplete#search keydown->airport-autocomplete#navigate"
              placeholder="City or airport"
              autocomplete="off"
              autofocus
              class="w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            >
            <%= f.hidden_field :origin_airport, data: { "airport-autocomplete-target": "code" } %>
            <div
              data-airport-autocomplete-target="dropdown"
              class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-xl shadow-lg p-1 max-h-64 overflow-y-auto"
            ></div>
          </div>
          <% if @search_intent.errors[:origin_airport].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:origin_airport].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :destination_airport, t("searches.new.to_label"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <div data-controller="airport-autocomplete" class="relative">
            <input
              type="text"
              data-airport-autocomplete-target="display"
              data-action="input->airport-autocomplete#search keydown->airport-autocomplete#navigate"
              placeholder="City or airport"
              autocomplete="off"
              class="w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            >
            <%= f.hidden_field :destination_airport, data: { "airport-autocomplete-target": "code" } %>
            <div
              data-airport-autocomplete-target="dropdown"
              class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-xl shadow-lg p-1 max-h-64 overflow-y-auto"
            ></div>
          </div>
          <% if @search_intent.errors[:destination_airport].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:destination_airport].first %></p>
          <% end %>
        </div>
      </div>

      <hr class="border-gray-100">

      <%# Travel window %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :earliest_departure, t("searches.new.earliest_departure"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :earliest_departure,
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:earliest_departure].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:earliest_departure].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :latest_return, t("searches.new.latest_return"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :latest_return,
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:latest_return].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:latest_return].first %></p>
          <% end %>
        </div>
      </div>

      <%# Stay length %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :min_stay_days, t("searches.new.min_stay"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :min_stay_days,
                min: 1, placeholder: "5",
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:min_stay_days].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:min_stay_days].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :max_stay_days, t("searches.new.max_stay"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :max_stay_days,
                min: 1, placeholder: "10",
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:max_stay_days].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:max_stay_days].first %></p>
          <% end %>
        </div>
      </div>

      <hr class="border-gray-100">

      <%# Preferences %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :max_stops, t("searches.new.max_stops_label"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.select :max_stops,
                options_for_select([
                  [t("searches.new.stops_any"), nil],
                  [t("searches.new.stops_direct"), 0],
                  [t("searches.new.stops_1"), 1],
                  [t("searches.new.stops_2"), 2]
                ], @search_intent.max_stops),
                {},
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :luggage_requirement, t("searches.new.luggage_label"), class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.select :luggage_requirement,
                options_for_select([
                  [t("searches.new.luggage_any"), nil],
                  [t("searches.new.luggage_carry_on"), "carry_on"],
                  [t("searches.new.luggage_checked"), "checked"],
                  [t("searches.new.luggage_none"), "none"]
                ], @search_intent.luggage_requirement),
                {},
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="pt-1">
        <%= f.submit t("searches.new.submit"),
              class: "w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold rounded-lg px-6 py-3 text-sm transition-colors cursor-pointer" %>
      </div>

    <% end %>
  </div>
</div>
