<% content_for :title, "Search Flights — Flexible Flights" %>

<div class="w-full max-w-xl mx-auto">
  <div class="mb-8 text-center">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight">Find the best time to fly</h1>
    <p class="mt-1.5 text-sm text-gray-500">We'll scan your travel window and tell you when to go — and whether to book now or wait.</p>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8">
    <%= form_with model: @search_intent, url: searches_path, class: "space-y-5" do |f| %>

      <%# Route %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :origin_airport, "From", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :origin_airport,
                placeholder: "JFK",
                maxlength: 3,
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-base font-semibold uppercase tracking-widest text-gray-900 placeholder:text-gray-300 placeholder:font-normal placeholder:tracking-normal focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                autofocus: true %>
          <% if @search_intent.errors[:origin_airport].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:origin_airport].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :destination_airport, "To", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :destination_airport,
                placeholder: "LHR",
                maxlength: 3,
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-base font-semibold uppercase tracking-widest text-gray-900 placeholder:text-gray-300 placeholder:font-normal placeholder:tracking-normal focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:destination_airport].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:destination_airport].first %></p>
          <% end %>
        </div>
      </div>

      <hr class="border-gray-100">

      <%# Travel window %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :earliest_departure, "Earliest departure", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :earliest_departure,
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:earliest_departure].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:earliest_departure].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :latest_return, "Latest return", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :latest_return,
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:latest_return].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:latest_return].first %></p>
          <% end %>
        </div>
      </div>

      <%# Stay length %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :min_stay_days, "Min stay (days)", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :min_stay_days,
                min: 1, placeholder: "5",
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:min_stay_days].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:min_stay_days].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :max_stay_days, "Max stay (days)", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :max_stay_days,
                min: 1, placeholder: "10",
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if @search_intent.errors[:max_stay_days].any? %>
            <p class="mt-1 text-xs text-red-500"><%= @search_intent.errors[:max_stay_days].first %></p>
          <% end %>
        </div>
      </div>

      <hr class="border-gray-100">

      <%# Preferences %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :max_stops, "Max stops", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.select :max_stops,
                options_for_select([["Any", nil], ["Direct only", 0], ["1 stop max", 1], ["2 stops max", 2]], @search_intent.max_stops),
                {},
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :luggage_requirement, "Luggage", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5" %>
          <%= f.select :luggage_requirement,
                options_for_select([["Any", nil], ["Carry-on", "carry_on"], ["Checked bag", "checked"], ["None", "none"]], @search_intent.luggage_requirement),
                {},
                class: "w-full bg-white rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="pt-1">
        <%= f.submit "Search flights",
              class: "w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold rounded-lg px-6 py-3 text-sm transition-colors cursor-pointer" %>
      </div>

    <% end %>
  </div>
</div>
