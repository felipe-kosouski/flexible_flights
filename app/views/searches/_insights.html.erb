<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

  <%# Wait or Book %>
  <% if (wob = insights.wait_or_book) %>
    <div class="rounded-xl border p-4 <%= wob.directive_color_class %>">
      <div class="flex items-start justify-between gap-2">
        <p class="text-xs font-medium uppercase tracking-wide opacity-60">Recommendation</p>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= wob.directive_badge_class %>">
          <%= wob.directive_label %>
        </span>
      </div>
      <p class="mt-2 text-sm font-medium"><%= wob.price_band_label %></p>
      <% if wob.top_price %>
        <p class="mt-1 text-xs opacity-70">Top options around <%= wob.top_price %></p>
      <% end %>
    </div>
  <% end %>

  <%# Price rarity %>
  <% if (rarity = insights.price_rarity) %>
    <div class="rounded-xl border p-4 <%= rarity.color_class %>">
      <div class="flex items-start justify-between gap-2">
        <p class="text-xs font-medium uppercase tracking-wide opacity-60">Price level</p>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= rarity.badge_class %>">
          <%= rarity.label %>
        </span>
      </div>
      <% if rarity.market_price %>
        <p class="mt-2 text-sm font-medium">Market price around <%= rarity.market_price %></p>
      <% end %>
    </div>
  <% end %>

  <%# Best time to travel %>
  <% if (btt = insights.best_time_to_travel) %>
    <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 text-indigo-900">
      <p class="text-xs font-medium uppercase tracking-wide opacity-60">Best time to travel</p>
      <p class="mt-2 text-sm font-semibold"><%= btt.date_range %></p>
      <p class="mt-1 text-xs opacity-70">
        Avg. score <%= btt.average_score %>/100 across <%= btt.flight_count %> <%= "option".pluralize(btt.flight_count) %>
      </p>
    </div>
  <% end %>

  <%# Cheapest comfort window %>
  <% if (ccw = insights.cheapest_comfort_window) %>
    <div class="rounded-xl border border-purple-200 bg-purple-50 p-4 text-purple-900">
      <p class="text-xs font-medium uppercase tracking-wide opacity-60">Best value window</p>
      <p class="mt-2 text-sm font-semibold"><%= ccw.date_range %></p>
      <p class="mt-1 text-xs opacity-70">
        Balances price and comfort &middot; avg. score <%= ccw.average_score %>/100
      </p>
    </div>
  <% end %>

</div>
