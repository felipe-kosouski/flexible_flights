<% content_for :title, "Set new password — Flexible Flights" %>

<div class="w-full max-w-md">
  <div class="bg-white rounded-2xl border border-gray-200 px-8 py-10">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight mb-8">Set new password</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-5">
        <div>
          <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <% if @minimum_password_length %>
            <em class="text-xs text-gray-400">(<%= @minimum_password_length %> characters minimum)</em>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" %>
        </div>

        <%= f.submit "Update password", class: "w-full bg-brand-700 hover:bg-brand-800 text-white text-sm font-semibold rounded-lg px-5 py-2.5 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
