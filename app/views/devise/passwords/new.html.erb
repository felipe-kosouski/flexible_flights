<% content_for :title, "Reset password — Flexible Flights" %>

<div class="w-full max-w-md">
  <div class="bg-white rounded-2xl border border-gray-200 px-8 py-10">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight mb-2">Reset password</h1>
    <p class="text-sm text-gray-500 mb-8">Enter your email and we&rsquo;ll send you a reset link.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-5">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" %>
        </div>

        <%= f.submit "Send reset link", class: "w-full bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg px-5 h-11 transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <p class="mt-6 text-center text-sm text-gray-500">
      <%= link_to "Back to sign in", new_user_session_path, class: "text-brand-700 hover:text-brand-800 font-medium" %>
    </p>
  </div>
</div>
