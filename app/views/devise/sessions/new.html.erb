<% content_for :title, "Sign in — Flexible Flights" %>

<div class="w-full max-w-md">
  <div class="bg-white rounded-2xl border border-gray-200 px-8 py-10">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight mb-8">Sign in</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-5">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" %>
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
            <%= f.check_box :remember_me %>
            Remember me
          </label>
          <%= link_to "Forgot password?", new_user_password_path, class: "text-sm text-brand-700 hover:text-brand-800" %>
        </div>

        <%= f.submit "Sign in", class: "w-full bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg px-5 h-11 transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <p class="mt-6 text-center text-sm text-gray-500">
      No account? <%= link_to "Sign up", new_user_registration_path, class: "text-brand-700 hover:text-brand-800 font-medium" %>
    </p>
  </div>
</div>
