<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Flexible Flights" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Flexible Flights">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200">
      <div class="container mx-auto px-5 h-14 flex items-center justify-between">
        <%= link_to "Flexible Flights", root_path, class: "font-semibold text-gray-900 tracking-tight" %>
        <% if user_signed_in? %>
          <div class="flex items-center gap-6">
            <%= link_to "History", search_history_path,
                  class: "text-sm text-gray-500 hover:text-gray-700 transition-colors" %>
            <div class="flex items-center gap-4">
              <%= link_to "Profile", profile_path,
                    class: "text-sm text-gray-500 hover:text-gray-700 transition-colors" %>
              <%= link_to "Sign out", destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: "text-sm text-gray-500 hover:text-gray-700 transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    </nav>
    <% if notice.present? %>
      <div class="container mx-auto px-5 pt-4">
        <p class="rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800"><%= notice %></p>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="container mx-auto px-5 pt-4">
        <p class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800"><%= alert %></p>
      </div>
    <% end %>
    <main class="container mx-auto px-5 py-10 flex justify-center">
      <%= yield %>
    </main>
  </body>
</html>
